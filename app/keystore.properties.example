# dterm release signing key. Committed in the repo so the GitHub workflow and
# every other machine sign every release build with the SAME key. This key is
# for testing/distribution only. oideating$, a real
# Play-upload key must still be used for Play; this key only signs the release
# APK in the workflow so the artifact in the GitHub Release is installable
# and testable as-is.
storeFile=keystore/dterm-release.keystore
storePassword=dtermtestkey1234
keyAlias=dtermreleasekey
keyPassword=dtermtestkey1234
